# Copie para .env e preencha. Nunca faça commit do .env. Todos os segredos ficam VAZIOS aqui de propósito.
# Conta do proprietário, criada na primeira inicialização (senha com no mínimo 12 caracteres).
OWNER_EMAIL=
OWNER_PASSWORD=
# true quando o painel for servido por HTTPS (obrigatório em produção).
AUTH_COOKIE_SECURE=false
# Chave de API legada para integrações (n8n etc.). VAZIA = X-API-Key desligada. Só preencha se precisar.
ADMIN_API_KEY=
POSTGRES_PASSWORD=
# mock = não chama nenhum modelo (grátis, só para testar o fluxo). ollama = modelo local.
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
MAX_TASK_ATTEMPTS=3
# Orçamento mensal de IA em dólares. 0 = nenhum provedor pago pode ser usado.
AI_MONTHLY_BUDGET_USD=0
LOG_LEVEL=INFO
# Banco: vazio = SQLite local. PostgreSQL: postgresql+psycopg://USUARIO:SENHA@HOST:5432/BANCO (o compose já define). Ver docs/BANCO.md.
# DATABASE_URL=
# Pasta dos arquivos gerados pelos agentes (planilhas etc.).
ARTIFACTS_DIR=storage/artifacts

# --- Provedores PAGOS (Fase 9). Só rodam com AI_MONTHLY_BUDGET_USD > 0 E chave, modelo e preços preenchidos.
# Os preços (US$ por milhão de tokens) você copia da tabela de preços do provedor; o sistema não assume nenhum.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_INPUT_USD_PER_MTOK=
ANTHROPIC_OUTPUT_USD_PER_MTOK=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_USD_PER_MTOK=
GEMINI_OUTPUT_USD_PER_MTOK=
# Teto de tokens de saída por chamada (limita o pior caso de custo).
AI_MAX_OUTPUT_TOKENS=1024
# Reserva gratuita quando o provedor pago está bloqueado: vazio ou "ollama" ("mock" não é aceito).
LLM_FALLBACK_PROVIDER=

# --- Webhooks do n8n (Fase 10). Vazio = webhooks desligados. Mínimo 32 caracteres.
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# É um segredo DIFERENTE do ADMIN_API_KEY: o n8n só enfileira tarefa e lê status; não aprova nada.
N8N_WEBHOOK_SECRET=

# --- Telegram (Fase 12). Vazio = desligado. O token vem do @BotFather; NUNCA cole o token em chat, issue ou commit.
TELEGRAM_BOT_TOKEN=
# IDs numéricos do Telegram autorizados, separados por vírgula. Vazio = o bot ignora todo mundo.
# Para descobrir o seu: mande /id ao bot (ele responde o seu número a qualquer pessoa).
TELEGRAM_ALLOWED_USER_IDS=
