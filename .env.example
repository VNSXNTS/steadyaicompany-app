# Copie para .env e preencha. Nunca faça commit do .env.
ADMIN_API_KEY=troque-por-uma-chave-longa-e-aleatoria
POSTGRES_PASSWORD=troque-esta-senha
# mock = não chama nenhum modelo (grátis, só para testar o fluxo). ollama = modelo local.
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
MAX_TASK_ATTEMPTS=3
# Orçamento mensal de IA em dólares. 0 = nenhum provedor pago pode ser usado.
AI_MONTHLY_BUDGET_USD=0
LOG_LEVEL=INFO
