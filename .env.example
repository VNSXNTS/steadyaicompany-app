# Copie para .env e preencha. Nunca faça commit do .env. Todos os segredos ficam VAZIOS aqui de propósito.
# Conta do proprietário, criada na primeira inicialização (senha de 12 a 128 caracteres).
OWNER_EMAIL=
OWNER_PASSWORD=
# development (padrão, HTTP local permitido) ou production. Em production o servidor NÃO INICIA sem
# AUTH_COOKIE_SECURE=true e desliga /docs, /redoc e /openapi.json.
APP_ENV=development
# true quando o painel for servido por HTTPS (obrigatório com APP_ENV=production).
AUTH_COOKIE_SECURE=false
# Proxies reversos confiáveis (IPs ou CIDRs, separados por vírgula). VAZIO = X-Forwarded-For é ignorado.
# Só preencha com o endereço do SEU proxy; qualquer outro valor deixa o cliente forjar o próprio IP.
TRUSTED_PROXIES=
# Origens extras aceitas em requisições que alteram dados (ex.: https://painel.exemplo.com). Vazio = só o próprio host.
ALLOWED_ORIGINS=
# Chave de API legada para integrações (n8n etc.). VAZIA = X-API-Key desligada. Só preencha se precisar.
ADMIN_API_KEY=
POSTGRES_PASSWORD=
# mock = não chama nenhum modelo (grátis, só para testar o fluxo). ollama = modelo local.
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
MAX_TASK_ATTEMPTS=3
# Orçamento mensal de IA em dólares. 0 = nenhum provedor pago pode ser usado.
AI_MONTHLY_BUDGET_USD=0
LOG_LEVEL=INFO
