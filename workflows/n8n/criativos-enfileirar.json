{
  "name": "Steady - Enfileirar conferência de criativo",
  "nodes": [
    {
      "id": "00000001-0000-4000-8000-000000000000",
      "name": "Teste manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        60,
        300
      ],
      "parameters": {}
    },
    {
      "id": "00000002-0000-4000-8000-000000000000",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-base_url",
              "name": "base_url",
              "value": "https://SEU-BACKEND-AQUI",
              "type": "string"
            },
            {
              "id": "cfg-headline",
              "name": "headline",
              "value": "",
              "type": "string"
            },
            {
              "id": "cfg-body",
              "name": "body",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "notes": "Edite aqui: base_url é o endereço do backend (HTTPS em produção).",
      "notesInFlow": true
    },
    {
      "id": "00000003-0000-4000-8000-000000000000",
      "name": "Exigir título",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        300
      ],
      "parameters": {
        "jsCode": "const c = $input.first().json;\nif (!String(c.headline || '').trim()) throw new Error('Preencha \"headline\" no nó Config com o título do criativo a conferir.');\nreturn [{ json: c }];"
      }
    },
    {
      "id": "00000004-0000-4000-8000-000000000000",
      "name": "Enfileirar conferência",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.base_url }}/webhooks/n8n/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "=criativo-{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_key: 'creative_director', description: 'Conferir criativo: ' + $json.headline.slice(0, 80), input: { tool: 'creative_check', headline: $json.headline, body: $json.body } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Steady Webhook"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "00000005-0000-4000-8000-000000000000",
      "name": "Ler tarefa criada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.base_url }}/webhooks/n8n/tasks/{{ $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Steady Webhook"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Teste manual": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Exigir título",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Exigir título": {
      "main": [
        [
          {
            "node": "Enfileirar conferência",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enfileirar conferência": {
      "main": [
        [
          {
            "node": "Ler tarefa criada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
