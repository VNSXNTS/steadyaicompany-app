{
  "name": "Steady - Relatório diário",
  "nodes": [
    {
      "id": "00000001-0000-4000-8000-000000000000",
      "name": "Todo dia às 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        60,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "00000002-0000-4000-8000-000000000000",
      "name": "Teste manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        60,
        400
      ],
      "parameters": {}
    },
    {
      "id": "00000003-0000-4000-8000-000000000000",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-base_url",
              "name": "base_url",
              "value": "https://SEU-BACKEND-AQUI",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "notes": "Edite aqui: base_url é o endereço do backend (HTTPS em produção).",
      "notesInFlow": true
    },
    {
      "id": "00000004-0000-4000-8000-000000000000",
      "name": "Buscar relatório",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.base_url }}/webhooks/n8n/report",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Steady Webhook"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "00000005-0000-4000-8000-000000000000",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst s = r.tasks_by_status || {};\nconst L = ['Relatório diário — Steady AI Company', '',\n  `Tarefas: pendentes ${s.pending || 0}, em execução ${s.running || 0}, aguardando aprovação ${s.awaiting_approval || 0}, concluídas ${s.completed || 0}, com falha ${s.failed || 0}, canceladas ${s.cancelled || 0}`,\n  `Aprovações pendentes: ${r.pending_approvals}`];\nif ((r.failed_tasks || []).length) L.push('', 'Tarefas com falha:', ...r.failed_tasks.map(t => `- #${t.id} (${t.agent}): ${t.error}`));\nif ((r.paused_agents || []).length) L.push('', 'Agentes pausados: ' + r.paused_agents.join(', '));\nif ((r.quality_rejected_tasks || []).length) L.push('', 'Produto barrado pelo Quality Guardian (tarefas): ' + r.quality_rejected_tasks.join(', '));\nif ((r.quality_gap_tasks || []).length) L.push('', 'Aprovado com verificações que não puderam rodar (tarefas): ' + r.quality_gap_tasks.join(', '));\nL.push('', r.attention_needed ? 'ATENÇÃO: há itens que precisam de você no painel.' : 'Nada exige sua ação agora.');\nreturn [{ json: { subject: r.attention_needed ? 'Steady: precisa de atenção' : 'Steady: relatório diário', text: L.join('\\n') } }];"
      }
    },
    {
      "id": "00000006-0000-4000-8000-000000000000",
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "fromEmail": "SEU_EMAIL@exemplo.com",
        "toEmail": "SEU_EMAIL@exemplo.com",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "disabled": true,
      "notes": "DESLIGADO de propósito: configure a credencial SMTP, troque os e-mails e ative este nó.",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Todo dia às 8h": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Teste manual": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Buscar relatório",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar relatório": {
      "main": [
        [
          {
            "node": "Montar mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar mensagem": {
      "main": [
        [
          {
            "node": "Enviar e-mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "pinData": {},
